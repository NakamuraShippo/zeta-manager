{
  "name": "zeta-log-companion",
  "version": "0.1.0",
  "private": true,
  "description": "Zeta Web版の会話ログを自動取得・保存・要約するChrome拡張 (Manifest V3)",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^26.4.0",
    "esbuild": "^0.24.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "~25.0.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
